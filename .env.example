# Flask Configuration
FLASK_SECRET_KEY=change-this-to-a-random-secret
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1

# Google Drive API Configuration
# Option 1: Put OAuth 2.0 Desktop credentials in ./credentials.json
# Option 2: Put Service Account JSON in ./service_account.json
GOOGLE_DRIVE_ROOT_FOLDER_NAME=DOD_Order_Media
# Optional explicit Google Drive folder ID for order media subfolders:
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Optional explicit private Google Drive folder ID for database backups:
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# Upload limits
MAX_VIDEO_SIZE_MB=200
